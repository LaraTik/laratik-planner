# ─────────────────────────────────────────────────────────────────────────────
# laratik-planner — environment contract
# See docs/operations/environment.md for full reference (no values, only names).
# Copy this file to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development                              # development | production | test
NEXT_PUBLIC_APP_URL=http://localhost:3000         # https://planner.laratik.com in prod
# APP_VERSION is injected automatically from the immutable Git SHA during image builds.
# Do not set it in local or production .env files.

# Postgres (docker-compose.dev.yml sets the local default; override in prod)
POSTGRES_USER=planner
POSTGRES_PASSWORD=change_me_local
POSTGRES_DB=planner
DATABASE_URL=postgresql://planner:change_me_local@localhost:5432/planner
# Disposable database for integration, migration-drill, and isolated browser
# tests. Create it once with the Docker recipe in docs/operations/runbook.md;
# never point this at the normal development or production database.
# TEST_DATABASE_URL=postgresql://planner:change_me_local@localhost:5432/planner_test

# NextAuth v5
AUTH_SECRET=                                       # openssl rand -base64 32
AUTH_URL=http://localhost:3000                     # https://planner.laratik.com in prod
AUTH_TRUST_HOST=true                               # required when behind Traefik

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Magic-link email — Mailcow SMTP via Nodemailer
# mail.laratik.com is already running on the VPS
SMTP_HOST=mail.laratik.com
SMTP_PORT=587
SMTP_USER=no-reply@planner.laratik.com
SMTP_PASSWORD=
SMTP_FROM="laratik-planner <no-reply@planner.laratik.com>"

# MiniMax (server-only; never NEXT_PUBLIC). Used by Goal 11 only.
# Falls back to Mavis if unset.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
MINIMAX_MODEL=MiniMax-M3
AI_FEATURE_ENABLED=false

# Master key for the in-DB AI provider secret (M3.4 — agency-level
# managed secret at /app/agency-settings/ai). AES-256-GCM; the plaintext
# key is never stored. The encryption layer resolves the KEK in this
# priority order:
#   1. AI_SECRET_ENCRYPTION_KEY env var (this line) — operator-set, takes
#      priority. RECOMMENDED in production: the auto-file fallback tries
#      to write to <LARATIK_DATA_DIR>/kek.json, which fails with EACCES
#      inside the container unless that path is on a writable volume.
#   2. Auto-managed KEK file at $LARATIK_DATA_DIR/kek.json (default
#      <cwd>/.laratik-planner/kek.json).
#   3. Derived dev fallback (dev/test only).
# Generate with: openssl rand -base64 32
# Length: ≥ 32 ASCII bytes. NEVER reuse AUTH_SECRET or any other secret.
AI_SECRET_ENCRYPTION_KEY=
# Directory the auto-managed KEK file lives in when AI_SECRET_ENCRYPTION_KEY
# is unset. MUST be a persistent volume in production (losing the file
# locks out every stored AI provider key). Defaults to <cwd>/.laratik-planner
# when unset. The docker-compose already mounts writable volumes at
# /app/data and /data/uploads — either works once the KEK fallback is
# enabled. Leave empty when AI_SECRET_ENCRYPTION_KEY is set.
LARATIK_DATA_DIR=

# Sentry (Goal 13 — error reporting + source maps)
# Server-side ingest URL. Generated by sentry.io when you create the project.
SENTRY_DSN=
# Same value as SENTRY_DSN, exposed to the browser (Next.js inlines NEXT_PUBLIC_*
# at build time). Keep it identical — they target the same project.
NEXT_PUBLIC_SENTRY_DSN=
# Build-time token for source-map upload. Created at sentry.io → Settings →
# Account → Security & Tokens, with scopes: project:releases, project:debug-files,
# project:write. NEVER ship this to the browser.
SENTRY_AUTH_TOKEN=
# Org + project slugs from the Sentry URL. Required at build time so
# `next.config.ts → withSentryConfig` actually uploads the source maps. Without
# these two, events still flow but every stack trace is minified garbage.
SENTRY_ORG=
SENTRY_PROJECT=
# Shared secret for the /api/sentry-probe route. The install script sets
# this and uses it to send a real event after wiring — proves ingest works
# before declaring the install done. Generate with: openssl rand -hex 32
SENTRY_PROBE_TOKEN=

# Cron secret (VPS-side daily digest endpoint)
CRON_SECRET=

# Bootstrap setup token (Goal 2; only required for the first administrator)
BOOTSTRAP_SETUP_TOKEN=

# Brand-kit local-volume storage (Goal 11.2 — see src/lib/storage/).
# `UPLOADS_DIR` is where logo/font uploads land on disk. The
# container's `docker-compose.yml` mounts a named volume
# (`laratik-planner-app-uploads`) at this path; in local dev the
# folder is created by the storage adapter at first write.
UPLOADS_DIR=/data/uploads
# 32+ char random string used to sign upload + download URLs.
# Generate with: openssl rand -hex 32
# NEVER reuse AUTH_SECRET or any other secret here.
UPLOAD_TOKEN_SECRET=replace-with-32-byte-random-hex

# Agency context cookie (Milestone 1.2 — src/lib/auth/agency-context.ts)
# HMAC secret used to sign the `laratik_active_agency` cookie. The
# cookie is the only client-side artifact that names an active agency;
# the signature is what makes a tampered cookie fail-closed, and the
# server still re-validates membership on every decode. MUST be ≥ 32
# bytes. The helper refuses to issue cookies in production when this
# is missing. Generate with:
#   openssl rand -base64 32
# NEVER reuse AUTH_SECRET, UPLOAD_TOKEN_SECRET, or any other secret here.
AGENCY_COOKIE_SECRET=

# ─── M4 — Social profile analytics (server-only) ───────────────────────────
# These variables are read by src/lib/validation/env.ts. None may be
# exposed as NEXT_PUBLIC_*. Generate the encryption key with:
#   openssl rand -base64 32
# The encryption key is required when SOCIAL_SYNC_ENABLED=true. Provider
# credentials are optional in dev so the rest of the app can boot
# without a Meta / TikTok app configured.
SOCIAL_TOKEN_ENCRYPTION_KEY=
META_APP_ID=
META_APP_SECRET=
META_LOGIN_CONFIG_ID=
META_GRAPH_API_VERSION=v25.0
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# When false, /api/cron/social-metrics is a no-op and the account picker
# hides the "Connect Meta" button. Default false in dev and prod.
SOCIAL_SYNC_ENABLED=false
# Per-provider gate. When false, the TikTok provider and callback routes
# return 404 / disabled. Default false until Meta's seven-day production
# observation window passes and the operator flips it on.
SOCIAL_TIKTOK_ENABLED=false
# Platform kill switch for Meta publishing readiness and the future queue.
# Keep false until App Review, Business Verification, sandbox, and canary gates pass.
META_PUBLISHING_ENABLED=false
