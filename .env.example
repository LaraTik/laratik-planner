# ─────────────────────────────────────────────────────────────────────────────
# laratik-planner — environment contract
# See docs/operations/environment.md for full reference (no values, only names).
# Copy this file to .env and fill in real values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development                              # development | production | test
NEXT_PUBLIC_APP_URL=http://localhost:3000         # https://planner.laratik.com in prod

# Postgres (docker-compose.dev.yml sets the local default; override in prod)
POSTGRES_USER=planner
POSTGRES_PASSWORD=change_me_local
POSTGRES_DB=planner
DATABASE_URL=postgresql://planner:change_me_local@localhost:5432/planner

# NextAuth v5
AUTH_SECRET=                                       # openssl rand -base64 32
AUTH_URL=http://localhost:3000                     # https://planner.laratik.com in prod
AUTH_TRUST_HOST=true                               # required when behind Traefik

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Magic-link email — Mailcow SMTP via Nodemailer
# mail.laratik.com is already running on the VPS
SMTP_HOST=mail.laratik.com
SMTP_PORT=587
SMTP_USER=no-reply@planner.laratik.com
SMTP_PASSWORD=
SMTP_FROM="laratik-planner <no-reply@planner.laratik.com>"

# MiniMax (server-only; never NEXT_PUBLIC). Used by Goal 11 only.
# Falls back to Mavis if unset.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
MINIMAX_MODEL=MiniMax-M3
AI_FEATURE_ENABLED=false

# Sentry (Goal 13; leave blank until wired)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Cron secret (VPS-side daily digest endpoint)
CRON_SECRET=

# Bootstrap setup token (Goal 2; only required for the first administrator)
BOOTSTRAP_SETUP_TOKEN=
