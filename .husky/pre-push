#!/usr/bin/env sh
# Pre-push hook — affected unit + integration feedback before a push.
#
# Full unit, integration, migration, build, audit, and browser gates remain
# authoritative in CI. Local E2E is available explicitly through
# `pnpm test:affected -- --layer browser` or `pnpm test:e2e:release`.
#
# Skip when you know what you're doing:
#   git push --no-verify
#   SKIP_PREPUSH=1 git push
#   SKIP_INTEGRATION=1 git push  (unit checks only)

set -e

if [ -n "$SKIP_PREPUSH" ] || [ -n "$SKIP_PRECOMMIT" ] || [ -n "$CI" ]; then
  echo "⏭  pre-push skipped (SKIP_PREPUSH=$SKIP_PREPUSH, SKIP_PRECOMMIT=$SKIP_PRECOMMIT, CI=$CI)"
  exit 0
fi

# Use the repository's safe disposable database when the developer has not
# supplied an override. The affected runner still enforces the test/CI URL
# guard before it starts integration tests.
if [ -z "${TEST_DATABASE_URL:-}" ]; then
  export TEST_DATABASE_URL="postgresql://planner:planner_dev_only@127.0.0.1:5432/planner_test"
  echo "ℹ TEST_DATABASE_URL not set; using the local disposable planner_test database."
fi

# Git supplies one line per ref being pushed on stdin. Build immutable commit
# ranges and deliberately omit the working tree so unrelated uncommitted work
# cannot change which tests a push runs.
ZERO="0000000000000000000000000000000000000000"
PUSH_RANGES=""
PUSH_HAS_TESTABLE_CHANGE=0

while read -r LOCAL_REF LOCAL_SHA _REMOTE_REF REMOTE_SHA; do
  [ -n "$LOCAL_REF" ] || continue
  case "$LOCAL_SHA" in
    "$ZERO") continue ;;
  esac

  if [ "$REMOTE_SHA" = "$ZERO" ]; then
    PUSH_BASE=$(git merge-base origin/main "$LOCAL_SHA" 2>/dev/null || true)
    if [ -z "$PUSH_BASE" ]; then
      PUSH_BASE=$(git rev-list --max-parents=0 "$LOCAL_SHA" | tail -n 1)
    fi
  else
    PUSH_BASE="$REMOTE_SHA"
  fi

  PUSH_RANGE="$PUSH_BASE...$LOCAL_SHA"
  if [ -n "$PUSH_RANGES" ]; then
    PUSH_RANGES=$(printf '%s\n%s' "$PUSH_RANGES" "$PUSH_RANGE")
  else
    PUSH_RANGES="$PUSH_RANGE"
  fi

  PUSHED_FILES=$(git diff --name-only "$PUSH_RANGE" 2>/dev/null || true)
  while IFS= read -r PUSHED_FILE; do
    [ -n "$PUSHED_FILE" ] || continue
    case "$PUSHED_FILE" in
      docs/*|*.md|*.mdx) ;;
      *) PUSH_HAS_TESTABLE_CHANGE=1; break ;;
    esac
  done <<EOF
$PUSHED_FILES
EOF
done

if [ "$PUSH_HAS_TESTABLE_CHANGE" -eq 0 ]; then
  echo "⏭ affected tests skipped (docs-only or ref-deletion push)"
  exit 0
fi

PUSH_LAYER=core
if [ -n "$SKIP_INTEGRATION" ]; then
  echo "⏭ integration selection disabled (SKIP_INTEGRATION=1)"
  PUSH_LAYER=unit
fi

printf '\n▶ affected unit/integration tests for pushed ranges:\n\n'
AFFECTED_PUSH_RANGES="$PUSH_RANGES" \
  pnpm test:affected -- --push --layer "$PUSH_LAYER"
