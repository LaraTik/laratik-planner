#!/usr/bin/env sh
# Pre-commit hook — local early warning for lint / format / typecheck /
# unit-test issues.
#
# Scope: catches the issues that most often fail CI (lint warnings,
# prettier drift, TypeScript regressions, regressions in unit-tested
# code) BEFORE the commit lands. NOT a replacement for CI — AGENTS.md
# "CI is authoritative".
#
# Skip when you know what you're doing:
#   git commit --no-verify
#   SKIP_PRECOMMIT=1 git commit
#   SKIP_TYPECHECK=1 git commit   (skip only the typecheck step)
#
# What runs:
#   1. lint-staged  → eslint --fix + prettier --write on staged files
#   2. pnpm typecheck (gated by a 5-min sentinel) → tsc --noEmit on
#      the full project. Skipped on a fresh tsbuildinfo OR if
#      tsbuildinfo is < 5 min old AND no .ts/.tsx is staged.
#   3. vitest related --run → unit tests that touch staged .ts/.tsx files
#
# What does NOT run (intentionally — kept for CI):
#   • pnpm build         (production build, slow on commit)
#   • pnpm test:integration (needs PostgreSQL)
#   • pnpm test:visual   (Playwright + 3-viewport matrix)
#   • the full unit suite (vitest related limits to affected files;
#     the full suite moved to .husky/pre-push per the 2026-08-26
#     CI-minimization plan)

set -e

# Skip in non-interactive contexts (CI, scripted release runs) and via flag.
if [ -n "$SKIP_PRECOMMIT" ] || [ -n "$CI" ]; then
  echo "⏭  pre-commit skipped (SKIP_PRECOMMIT=$SKIP_PRECOMMIT, CI=$CI)"
  exit 0
fi

# 1) Lint + format on staged files (fast, per-file).
npx --no-install lint-staged

# 2) TypeScript typecheck. Sentinel-driven so a warm `tsc` cache skips
# the work on a docs-only or non-TS commit. The full project typecheck
# (`tsc --noEmit`) is what CI used to run; per the 2026-08-26 plan it
# moved here so a type regression is caught before CI minutes are
# spent. Sentinel logic:
#   - Always run if no tsbuildinfo exists.
#   - Always run if any staged file is .ts/.tsx.
#   - Run if tsbuildinfo is older than 5 min (catches upstream dep drift).
#   - Otherwise skip (warm cache, no TS surface changed).
STAGED_TS_FILES=$(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx' 2>/dev/null || true)
TSBUILDINFO="./tsconfig.tsbuildinfo"
TYPECHECK_NEEDED=0

if [ ! -f "$TSBUILDINFO" ]; then
  TYPECHECK_NEEDED=1
elif [ -n "$STAGED_TS_FILES" ]; then
  TYPECHECK_NEEDED=1
elif find . -name "$TSBUILDINFO" -mmin +5 2>/dev/null | grep -q .; then
  TYPECHECK_NEEDED=1
fi

if [ -n "$SKIP_TYPECHECK" ]; then
  echo "⏭  typecheck skipped (SKIP_TYPECHECK=1)"
elif [ "$TYPECHECK_NEEDED" -eq 1 ]; then
  printf '\n▶ pnpm typecheck — tsc --noEmit:\n\n'
  pnpm typecheck
else
  echo "⏭  typecheck skipped (warm cache, no TS changes, tsbuildinfo < 5 min)"
fi

# 3) Unit tests for staged source files. `vitest related` walks the
# import graph from the listed source files to the affected test files,
# so a 1-line change in `src/lib/auth/policy.ts` runs only the auth
# tests, not the whole suite. Deleted files are excluded with
# --diff-filter=ACMR so we don't pass paths that no longer exist on
# disk.
if [ -n "$STAGED_TS_FILES" ]; then
  printf '\n▶ vitest related — %d staged source file(s):\n' "$(printf '%s\n' "$STAGED_TS_FILES" | wc -l | tr -d ' ')"
  printf '  %s\n' $STAGED_TS_FILES
  printf '\n'
  # shellcheck disable=SC2086  # word splitting on $STAGED_TS_FILES is intentional
  pnpm exec vitest related --run $STAGED_TS_FILES
fi
