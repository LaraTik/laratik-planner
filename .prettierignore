# Don't format raw SQL migrations — Prettier doesn't have a SQL parser
# plugin installed, and the Drizzle migrations are usually hand-tweaked
# for idempotency. We do format .ts / .tsx / .json / .md via the
# project prettier config.
src/lib/db/migrations/*.sql

# Stitch design assets are generated by Google Stitch and live as the
# visual source of truth. They must NOT be reformatted by Prettier —
# doing so would mutate the canonical references and break any future
# visual-diff harness that compares against the raw Stitch output.
designs/stitch/
